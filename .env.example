APP_NAME=Services
APP_ENV=local

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=services
DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGO=HS256
JWT_TTL=10080
JWT_ISSUER=services

OTP_LENGTH=6
OTP_TTL=5
# Set false in production so OTP is not returned in the API response
OTP_RETURN_IN_RESPONSE=true

# Username/password for POST /api/migrate (not JWT)
MIGRATE_USERNAME=admin
MIGRATE_PASSWORD=change-me

# SMS gateway: log (dev) | smsir (production / real send)
SMS_DRIVER=log
SMS_IR_API_KEY=
# Sandbox default template id is 123456 with #CODE#
SMS_IR_TEMPLATE_ID=123456
SMS_IR_PARAMETER_NAME=CODE
